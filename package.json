{
  "name": "openfsm",
  "version": "0.1.0",
  "private": true,
  "description": "Open Source Field Service Management Platform",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @openfsm/db migrate",
    "db:seed": "pnpm --filter @openfsm/db seed",
    "db:generate": "pnpm --filter @openfsm/db generate",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
